{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenLabel SAVANT Subset",
  "type": "object",
  "properties": {
    "openlabel": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "1.3.0"
            },
            "tagged_file": {
              "type": "string"
            },
            "annotator": {
              "type": "string"
            }
          },
          "required": [
            "schema_version",
            "tagged_file",
            "annotator"
          ]
        },
        "ontologies": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "coordinate_systems": {
          "type": "object",
          "description": "Coordinate systems referenced by cuboids (e.g. COSMO's world system)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "parent": {
                "type": "string"
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "parent"
            ]
          }
        },
        "objects": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "ontology_uid": {
                  "type": "string"
                },
                "frame_intervals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "frame_start": {
                        "type": "integer"
                      },
                      "frame_end": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "frame_start",
                      "frame_end"
                    ],
                    "additionalProperties": false
                  }
                },
                "object_data": {
                  "type": "object",
                  "properties": {
                    "vec": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "val": {
                            "type": "array",
                            "items": {
                              "type": [
                                "number",
                                "string"
                              ]
                            }
                          }
                        },
                        "required": [
                          "name",
                          "val"
                        ]
                      }
                    },
                    "num": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "val": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "name",
                          "val"
                        ]
                      }
                    },
                    "text": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "val": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "val"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "type",
                "ontology_uid"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "actions": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "ontology_uid": {
                  "type": "string"
                },
                "frame_intervals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "frame_start": {
                        "type": "integer"
                      },
                      "frame_end": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "frame_start",
                      "frame_end"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "type",
                "ontology_uid"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "relations": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "ontology_uid": {
                  "type": "string"
                },
                "frame_intervals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "frame_start": {
                        "type": "integer"
                      },
                      "frame_end": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "frame_start",
                      "frame_end"
                    ],
                    "additionalProperties": false
                  }
                },
                "rdf_subjects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "object",
                          "action",
                          "event",
                          "context"
                        ]
                      },
                      "uid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "uid"
                    ]
                  }
                },
                "rdf_objects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "object",
                          "action",
                          "event",
                          "context"
                        ]
                      },
                      "uid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "uid"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "type",
                "ontology_uid",
                "rdf_subjects",
                "rdf_objects"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "contexts": {
          "type": "object",
          "description": "Nonspatial/temporal annotations for scene context (weather, road type, etc.)",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "ontology_uid": {
                  "type": "string"
                },
                "frame_intervals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "frame_start": {
                        "type": "integer"
                      },
                      "frame_end": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "frame_start",
                      "frame_end"
                    ],
                    "additionalProperties": false
                  }
                },
                "context_data": {
                  "type": "object",
                  "properties": {
                    "boolean": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "val": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "name",
                          "val"
                        ]
                      }
                    },
                    "num": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "val": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "name",
                          "val"
                        ]
                      }
                    },
                    "text": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "val": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "val"
                        ]
                      }
                    },
                    "vec": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "val": {
                            "type": "array",
                            "items": {
                              "type": [
                                "number",
                                "string"
                              ]
                            }
                          }
                        },
                        "required": [
                          "name",
                          "val"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "object",
          "description": "Scenario-level metadata tags",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "ontology_uid": {
                  "type": "string"
                },
                "tag_data": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "boolean": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "val": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "name",
                              "val"
                            ]
                          }
                        },
                        "num": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "val": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "name",
                              "val"
                            ]
                          }
                        },
                        "text": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "val": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "val"
                            ]
                          }
                        },
                        "vec": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "val": {
                                "type": "array",
                                "items": {
                                  "type": [
                                    "number",
                                    "string"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "name",
                              "val"
                            ]
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "ontology_uid",
                "type"
              ]
            }
          },
          "additionalProperties": false
        },
        "frames": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "properties": {
                "objects": {
                  "type": "object",
                  "patternProperties": {
                    "^[0-9]+$": {
                      "type": "object",
                      "properties": {
                        "object_data": {
                          "type": "object",
                          "properties": {
                            "rbbox": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  },
                                  "val": {
                                    "type": "array",
                                    "items": {
                                      "type": "number"
                                    },
                                    "minItems": 5,
                                    "maxItems": 5
                                  },
                                  "coordinate_system": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "name",
                                  "val"
                                ]
                              }
                            },
                            "vec": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  },
                                  "val": {
                                    "type": "array",
                                    "items": {
                                      "type": [
                                        "number",
                                        "string"
                                      ]
                                    }
                                  }
                                },
                                "required": [
                                  "name",
                                  "val"
                                ]
                              }
                            },
                            "cuboid": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  },
                                  "val": {
                                    "type": "array",
                                    "items": {
                                      "type": "number"
                                    },
                                    "minItems": 9,
                                    "maxItems": 10
                                  },
                                  "coordinate_system": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "name",
                                  "val"
                                ]
                              }
                            }
                          },
                          "required": [
                            "vec"
                          ],
                          "additionalProperties": false,
                          "anyOf": [
                            {
                              "required": [
                                "rbbox"
                              ]
                            },
                            {
                              "required": [
                                "cuboid"
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "object_data"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "frame_properties": {
                  "type": "object",
                  "properties": {
                    "timestamp": {
                      "type": [
                        "string",
                        "number"
                      ],
                      "description": "Frame time: video timestamp HH:MM:SS.ffffff (markit) or seconds (COSMO)"
                    },
                    "review": {
                      "type": "object",
                      "description": "Key-frame review by edit: every box in the frame was checked by a person",
                      "properties": {
                        "annotator": {
                          "type": "string"
                        },
                        "time": {
                          "type": "string",
                          "description": "ISO 8601"
                        }
                      },
                      "required": [
                        "annotator"
                      ]
                    }
                  }
                }
              },
              "required": [
                "objects"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "streams": {
          "type": "object",
          "description": "Recording streams (e.g. camera sources)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              },
              "stream_properties": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "metadata",
        "ontologies",
        "objects",
        "actions",
        "relations",
        "frames"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "openlabel"
  ],
  "additionalProperties": false
}
