@prefix : <https://ri-se.github.io/SAVANT/ontology/savant_scenario#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix openlabel: <https://openlabel.asam.net/V1-0-0/ontologies/> .

# Ontology metadata
<https://ri-se.github.io/SAVANT/ontology/savant_scenario> a owl:Ontology ;
    owl:versionInfo "2.1.0" ;
    owl:versionIRI <https://ri-se.github.io/SAVANT/ontology/savant_scenario/2.1.0> ;
    rdfs:label "SAVANT Scenario Ontology" ;
    rdfs:comment "Scenario tags and contexts used by SAVANT. Classes and properties marked with rdfs:seeAlso openlabel:<Name> mirror the ASAM OpenLABEL V1.0.0 scenario tagging ontology with identical names and hierarchy (only the subset SAVANT uses), so this ontology can be replaced by OpenLABEL 1:1. Remaining classes are SAVANT extensions subclassing mirrored classes." .

:uid a owl:AnnotationProperty ;
    rdfs:label "UID" ;
    rdfs:comment "A unique identifier assigned to a class or resource. Scenario ontology uids start at 1000 to stay disjoint from savant.ttl" ;
    rdfs:range xsd:integer .

# =============================================================================
# Classes mirrored from ASAM OpenLABEL V1.0.0 (UID 1000-1999), in OpenLABEL file order
# =============================================================================

:Tag a rdfs:Class ;
    rdfs:label "Base Tag"@en ;
    rdfs:seeAlso openlabel:Tag ;
    :uid 1000 .

:Odd a rdfs:Class ;
    rdfs:subClassOf :Tag ;
    rdfs:label "ODD"@en ;
    rdfs:seeAlso openlabel:Odd ;
    :uid 1001 .

:OddEnvironment a rdfs:Class ;
    rdfs:subClassOf :Odd ;
    rdfs:label "Environmental Conditions"@en ;
    rdfs:seeAlso openlabel:OddEnvironment ;
    :uid 1002 .

:EnvironmentWeather a rdfs:Class ;
    rdfs:subClassOf :OddEnvironment ;
    rdfs:label "Weather"@en ;
    rdfs:seeAlso openlabel:EnvironmentWeather ;
    :uid 1003 .

:WeatherRain a rdfs:Class ;
    rdfs:subClassOf :EnvironmentWeather ;
    rdfs:label "Rainfall"@en ;
    rdfs:seeAlso openlabel:WeatherRain ;
    :uid 1004 .

:WeatherSnow a rdfs:Class ;
    rdfs:subClassOf :EnvironmentWeather ;
    rdfs:label "Snowfall"@en ;
    rdfs:seeAlso openlabel:WeatherSnow ;
    :uid 1005 .

:EnvironmentParticulates a rdfs:Class ;
    rdfs:subClassOf :OddEnvironment ;
    rdfs:label "Particulates (obscuration by nonPrecipitating water droplets and other particulates)"@en ;
    rdfs:seeAlso openlabel:EnvironmentParticulates ;
    :uid 1006 .

:ParticulatesWater a rdfs:Class ;
    rdfs:subClassOf :EnvironmentParticulates ;
    rdfs:label "Non-precipitating water droplets or ice crystals (i.e. mist/fog)"@en ;
    rdfs:seeAlso openlabel:ParticulatesWater ;
    :uid 1007 .

:ParticulatesDust a rdfs:Class ;
    rdfs:subClassOf :EnvironmentParticulates ;
    rdfs:label "Sand and dust"@en ;
    rdfs:seeAlso openlabel:ParticulatesDust ;
    :uid 1008 .

:ParticulatesPollution a rdfs:Class ;
