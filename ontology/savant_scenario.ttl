# --- Mirrored OpenLABEL properties ---
:laneSpecificationLaneCountValue a rdfs:Property ;
    rdfs:label "Number of lanes (Unit)"@en ;
    rdfs:domain :LaneSpecificationLaneCount ;
    rdfs:range xsd:positiveInteger ;
    rdfs:seeAlso openlabel:laneSpecificationLaneCountValue .

:trafficAgentTypeValue a rdfs:Property ;
    rdfs:label "Agent type"@en ;
    rdfs:domain :TrafficAgentType ;
    rdfs:range :RoadUser ;
    rdfs:seeAlso openlabel:trafficAgentTypeValue .

# =============================================================================
# SAVANT extension: administrative tags (UID 2100-2199)
# =============================================================================

:VLMAnalysisTag a rdfs:Class ;
    rdfs:subClassOf :AdminTag ;
    rdfs:label "VLMAnalysisTag" ;
    rdfs:comment "Metadata about the VLM analysis process, including model name and average confidence" ;
    :uid 2106 .

:NotesTag a rdfs:Class ;
    rdfs:subClassOf :AdminTag ;
    rdfs:label "NotesTag" ;
    rdfs:comment "Free-text scene observations that do not fit other tags" ;
    :uid 2109 .

# =============================================================================
# SAVANT extension: environment (UID 2200-2249)
# =============================================================================

# --- Precipitation intensity (OpenLABEL only has numeric rain intensity in mm/h) ---
:PrecipitationLight a rdfs:Class ;
    rdfs:subClassOf :EnvironmentWeather ;
    rdfs:label "Light precipitation"@en ;
    :uid 2200 .

:PrecipitationModerate a rdfs:Class ;
    rdfs:subClassOf :EnvironmentWeather ;
    rdfs:label "Moderate precipitation"@en ;
    :uid 2201 .

:PrecipitationHeavy a rdfs:Class ;
    rdfs:subClassOf :EnvironmentWeather ;
    rdfs:label "Heavy precipitation"@en ;
    :uid 2202 .

# --- Explicit absence (OpenLABEL tags only what is present; "none" is a statement, not a missing value) ---
:WeatherNoPrecipitation a rdfs:Class ;
    rdfs:subClassOf :EnvironmentWeather ;
    rdfs:label "No precipitation"@en ;
    rdfs:comment "Neither rain nor snow was observed; distinguishes a dry scene from one where precipitation could not be determined (no tag)" ;
    :uid 2203 .

# --- Particulates ---
:ParticulatesFog a rdfs:Class ;
    rdfs:subClassOf :ParticulatesWater ;
    rdfs:label "Fog"@en ;
    :uid 2210 .

:ParticulatesMist a rdfs:Class ;
    rdfs:subClassOf :ParticulatesWater ;
    rdfs:label "Mist"@en ;
    :uid 2211 .

:ParticulatesHaze a rdfs:Class ;
    rdfs:subClassOf :ParticulatesPollution ;
    rdfs:label "Haze"@en ;
    :uid 2212 .

:ParticulatesSmoke a rdfs:Class ;
    rdfs:subClassOf :ParticulatesPollution ;
    rdfs:label "Smoke"@en ;
    :uid 2213 .

# --- Visibility ---
:EnvironmentVisibility a rdfs:Class ;
    rdfs:subClassOf :OddEnvironment ;
    rdfs:label "Visibility"@en ;
    rdfs:comment "Estimated visibility regardless of cause" ;
    :uid 2220 .

:environmentVisibilityValue a rdfs:Property ;
    rdfs:label "Visibility (km)"@en ;
    rdfs:domain :EnvironmentVisibility ;
    rdfs:range xsd:decimal .

# --- Illumination ---
:LowLightDawn a rdfs:Class ;
    rdfs:subClassOf :LowLightAmbient ;
    rdfs:label "Dawn"@en ;
    :uid 2230 .

:LowLightDusk a rdfs:Class ;
    rdfs:subClassOf :LowLightAmbient ;
    rdfs:label "Dusk"@en ;
    :uid 2231 .

# Cloudiness levels (OpenLABEL only has numeric cloud cover in okta)
:CloudinessClear a rdfs:Class ;
    rdfs:subClassOf :IlluminationCloudiness ;
    rdfs:label "Clear sky"@en ;
    rdfs:comment "Approximately 0-1 okta" ;
    :uid 2240 .

:CloudinessPartlyCloudy a rdfs:Class ;
    rdfs:subClassOf :IlluminationCloudiness ;
    rdfs:label "Partly cloudy"@en ;
    rdfs:comment "Approximately 2-6 okta" ;
    :uid 2241 .

:CloudinessOvercast a rdfs:Class ;
    rdfs:subClassOf :IlluminationCloudiness ;
    rdfs:label "Overcast"@en ;
    rdfs:comment "Approximately 7-8 okta" ;
    :uid 2242 .

# =============================================================================
# SAVANT extension: scenery (UID 2250-2299)
# =============================================================================

:SurfaceTypeAsphalt a rdfs:Class ;
    rdfs:subClassOf :SurfaceTypeUniform ;
    rdfs:label "Asphalt"@en ;
    :uid 2250 .

:SurfaceTypeConcrete a rdfs:Class ;
    rdfs:subClassOf :SurfaceTypeUniform ;
    rdfs:label "Concrete"@en ;
    :uid 2251 .

:SurfaceConditionDry a rdfs:Class ;
    rdfs:subClassOf :DrivableAreaSurfaceCondition ;
    rdfs:label "Dry"@en ;
    :uid 2260 .

:JunctionSignalized a rdfs:Class ;
    rdfs:subClassOf :SceneryJunction ;
    rdfs:label "Signalized junction"@en ;
    rdfs:comment "Junction controlled by traffic signals (OpenLABEL only distinguishes this for roundabouts)" ;
    :uid 2270 .

:TemporaryStructureConstruction a rdfs:Class ;
    rdfs:subClassOf :SceneryTemporaryStructure ;
    rdfs:label "Construction site"@en ;
    :uid 2280 .

# =============================================================================
# SAVANT extension: dynamic elements (UID 2300-2349)
# =============================================================================

# Traffic density levels (OpenLABEL only has numeric density in vehicles/km)
:TrafficDensityEmpty a rdfs:Class ;
    rdfs:subClassOf :TrafficAgentDensity ;
    rdfs:label "Empty"@en ;
    :uid 2300 .

:TrafficDensitySparse a rdfs:Class ;
    rdfs:subClassOf :TrafficAgentDensity ;
    rdfs:label "Sparse"@en ;
    :uid 2301 .

:TrafficDensityModerate a rdfs:Class ;
    rdfs:subClassOf :TrafficAgentDensity ;
    rdfs:label "Moderate"@en ;
    :uid 2302 .

:TrafficDensityDense a rdfs:Class ;
    rdfs:subClassOf :TrafficAgentDensity ;
    rdfs:label "Dense"@en ;
    :uid 2303 .

:TrafficDensityCongested a rdfs:Class ;
    rdfs:subClassOf :TrafficAgentDensity ;
    rdfs:label "Congested"@en ;
    :uid 2304 .

# Traffic flow levels (OpenLABEL only has numeric flow rate in vehicles/h)
:TrafficFlowFree a rdfs:Class ;
    rdfs:subClassOf :TrafficFlowRate ;
    rdfs:label "Free flow"@en ;
    :uid 2310 .

:TrafficFlowStable a rdfs:Class ;
    rdfs:subClassOf :TrafficFlowRate ;
    rdfs:label "Stable flow"@en ;
    :uid 2311 .

:TrafficFlowUnstable a rdfs:Class ;
    rdfs:subClassOf :TrafficFlowRate ;
    rdfs:label "Unstable flow"@en ;
    :uid 2312 .

:TrafficFlowForced a rdfs:Class ;
    rdfs:subClassOf :TrafficFlowRate ;
    rdfs:label "Forced flow"@en ;
    :uid 2313 .
